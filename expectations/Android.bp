package {
    default_visibility: [
        "//external/conscrypt:__subpackages__",
    ],
    default_applicable_licenses: ["external_conscrypt_license"],
}

java_library {
    name: "conscrypt-expectations-jar",
    java_resources: [
        "knownfailures.txt",
        "skippedCtsTest.txt",
    ],
}

java_library {
    name: "conscrypt-skippedCtsTest-manual-base-jar",
    host_supported: true,
    java_resources: ["skippedCtsTest_manual_base.txt"],
    sdk_version: "core_current",
}
